# Backend environment variables (copy to .env and fill values)
# Server
PORT=8000

# Model config
# Path where model .pt files are stored (relative to backend folder)
MODELS_DIR=models
DEFAULT_MODEL=YOLOv8s-seg

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=https://cardio-vision-murex.vercel.app

# Inference provider: "local" (legacy) or "modal" (Render proxies to Modal)
INFERENCE_PROVIDER=modal

# Modal inference endpoint (set in Render dashboard; never committed)
MODAL_INFERENCE_URL=https://<your-modal-endpoint>.modal.run

# Shared secret for Render -> Modal auth (set in Render dashboard; sync: false)
MODAL_INFERENCE_TOKEN=<shared-secret>

# Modal client timeouts (seconds)
MODAL_CONNECT_TIMEOUT=10.0
MODAL_READ_TIMEOUT=300.0

# Gemini / Google generative AI
GEMINI_API_KEY=

# Any other secrets (database URLs, storage keys)
DATABASE_URL=
STORAGE_KEY=

