# Backend environment variables (copy to .env and fill values)
# Server
PORT=8000

# Model config
# Path where model .pt files are stored (relative to backend folder)
MODELS_DIR=models
DEFAULT_MODEL=YOLOv8s-seg

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=*

# Gemini / Google generative AI
GEMINI_API_KEY=

# Any other secrets (database URLs, storage keys)
DATABASE_URL=
STORAGE_KEY=

